---
import { CopyButton } from "./copy-button";
import {
  CODE_HIGHLIGHT_FOREGROUND,
  highlightCode,
  type CodeHighlightLanguage,
} from "../lib/code-highlighter";

type CodeBlockVariant = "inline" | "stacked";

type Props = {
  code?: string;
  language?: CodeHighlightLanguage;
  lines?: Array<Array<{ text: string; className?: string }>>;
  copyContent?: string;
  variant?: CodeBlockVariant;
  align?: "start" | "center";
  truncate?: boolean;
  wrapOnMobile?: boolean;
  mobileSurface?: boolean;
  compact?: boolean;
  className?: string;
  id?: string;
};

const {
  code,
  language = "bash",
  lines = [],
  copyContent,
  variant,
  align: alignProp,
  truncate: truncateProp,
  wrapOnMobile: wrapOnMobileProp,
  mobileSurface: mobileSurfaceProp,
  compact = false,
  className = "",
  id,
} = Astro.props as Props;

const align =
  alignProp ?? (variant === "inline" ? "center" : variant === "stacked" ? "start" : "start");
const truncate = truncateProp ?? variant === "inline";
const wrapOnMobile = wrapOnMobileProp ?? variant === "stacked";
const mobileSurface = mobileSurfaceProp ?? variant === "stacked";

const highlightedHtml = code ? await highlightCode(code, language) : null;
const content = copyContent ?? code ?? lines.map((line) => line.map((segment) => segment.text).join("")).join("\n");
const alignClass = align === "center" ? "items-center" : "items-start";
const preStyle = `color: ${CODE_HIGHLIGHT_FOREGROUND}`;
const preClass = truncate
  ? `m-0 min-w-0 flex-1 overflow-hidden pr-3 font-mono ${compact ? "text-sm leading-5" : "text-base leading-6"} text-ellipsis whitespace-nowrap`
  : wrapOnMobile
    ? `m-0 min-w-0 flex-1 whitespace-pre-wrap break-words pr-3 font-mono ${compact ? "text-sm leading-5" : "text-base leading-6"} sm:whitespace-nowrap`
    : `m-0 min-w-0 flex-1 pr-3 font-mono ${compact ? "text-sm leading-5" : "text-base leading-6"}`;
const paddingClass = compact ? "py-2 pr-3 pl-4" : "py-3.5 pr-4 pl-6";
const shellClass = mobileSurface
  ? `relative flex justify-between rounded-[8px] border-none bg-white ${paddingClass} shadow-2xs ring-1 ring-black/10`
  : `relative flex justify-between rounded-none border-t border-b border-parchment-200 bg-white ${paddingClass} shadow-2xs sm:rounded-[8px] sm:border-none sm:ring-1 sm:ring-black/10`;
---

<div id={id} class={`${shellClass} ${alignClass} ${className}`}>
  <pre class={preClass} style={preStyle}>
    {
      highlightedHtml ? (
        <code class="[&_.line]:block" set:html={highlightedHtml} />
      ) : (
        <code>
          {lines.map((line, lineIndex) => (
            <>
              {line.map((segment) => (
                <span class={segment.className}>{segment.text}</span>
              ))}
              {lineIndex < lines.length - 1 ? <br /> : null}
            </>
          ))}
        </code>
      )
    }
  </pre>
  <div class="flex items-center gap-1">
    <CopyButton
      content={content}
      showText={false}
      className={compact ? "size-7" : "size-8"}
      client:load
    />
  </div>
  <slot />
</div>
