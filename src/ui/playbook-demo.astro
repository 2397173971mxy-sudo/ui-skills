---
import type { PlaybookEntry } from "../data/playbook.ts";

type Props = {
  entry: PlaybookEntry;
};

const { entry } = Astro.props as Props;

const demoShell =
  "rounded-[16px] border border-neutral-200 bg-white p-5 shadow-2xs sm:p-6";
---

<div class={demoShell}>
  {
    entry.slug === "use-text-balance" ? (
      <div class="space-y-3">
        <h2 class="max-w-[14ch] text-3xl font-medium tracking-tight text-balance text-parchment-900">
          Design with fewer awkward line breaks
        </h2>
        <p class="max-w-xl text-base leading-snug text-pretty text-parchment-600">
          A balanced heading stays readable, and the paragraph keeps its shape
          when the line length shifts.
        </p>
      </div>
    ) : entry.slug === "use-aria-labels-for-icon-buttons" ? (
      <div class="flex items-center justify-between gap-4">
        <div>
          <p class="text-base font-medium text-parchment-900">Inbox</p>
          <p class="text-base text-parchment-500">3 unread messages</p>
        </div>
        <button
          type="button"
          aria-label="Close inbox"
          class="inline-flex size-11 items-center justify-center rounded-full border border-neutral-200 bg-parchment-50 text-parchment-900 transition-colors hover:bg-parchment-100"
        >
          <span class="text-xl leading-none">×</span>
        </button>
      </div>
    ) : entry.slug === "animate-transform-and-opacity-only" ? (
      <div class="space-y-4">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-base font-medium text-parchment-900">Panel transition</p>
            <p class="text-base text-parchment-500">Only the shape and opacity move.</p>
          </div>
          <div class="rounded-full bg-emerald-100 px-2.5 py-1 text-sm font-medium text-emerald-700">
            Smooth
          </div>
        </div>
        <div class="relative h-28 overflow-hidden rounded-2xl border border-neutral-200 bg-parchment-50">
          <div class="absolute left-4 top-4 h-20 w-40 rounded-2xl bg-parchment-900/90 text-white shadow-sm transition-transform transition-opacity duration-200 ease-out hover:translate-x-6 hover:opacity-90" />
        </div>
      </div>
    ) : entry.slug === "set-canonical-and-social-metadata" ? (
      <div class="space-y-4">
        <div class="rounded-[14px] border border-neutral-200 bg-parchment-50 p-4">
          <p class="text-sm font-medium uppercase tracking-wide text-parchment-500">Search preview</p>
          <h3 class="mt-2 text-lg font-medium text-balance text-parchment-900">Playbook | UI Skills</h3>
          <p class="mt-1 max-w-xl text-base text-pretty text-parchment-600">
            Distilled UI lessons from the registry, with examples, prompts, and related skills.
          </p>
        </div>
        <div class="grid gap-3 sm:grid-cols-3">
          {[
            ["Canonical", "/playbook/use-text-balance"],
            ["Open Graph", "Preview card"],
            ["Twitter", "Summary image"],
          ].map(([label, value]) => (
            <div class="rounded-2xl border border-neutral-200 bg-white p-4">
              <p class="text-sm font-medium uppercase tracking-wide text-parchment-500">{label}</p>
              <p class="mt-2 text-base font-medium text-parchment-900">{value}</p>
            </div>
          ))}
        </div>
      </div>
    ) : entry.slug === "use-tabular-nums-for-data" ? (
      <div class="space-y-4">
        <div class="flex items-end justify-between gap-4">
          {[
            ["Visitors", "12,840"],
            ["Conversion", "4.2%"],
            ["Revenue", "$9,420"],
          ].map(([label, value]) => (
            <div class="rounded-2xl border border-neutral-200 bg-parchment-50 px-4 py-3">
              <p class="text-sm font-medium uppercase tracking-wide text-parchment-500">{label}</p>
              <p class="mt-1 text-2xl font-medium tabular-nums text-parchment-900">{value}</p>
            </div>
          ))}
        </div>
      </div>
    ) : (
      <div class="rounded-[14px] border border-dashed border-neutral-200 bg-parchment-50 p-5 text-base text-pretty text-parchment-600">
        {entry.direct}
      </div>
    )
  }
</div>
