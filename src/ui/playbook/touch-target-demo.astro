<div class="grid gap-5 sm:grid-cols-2">
  <div class="space-y-3">
    <p class="text-parchment-500 font-mono text-xs">Too small</p>
    <div
      class="border-parchment-300 flex items-center gap-3 rounded-lg border border-dashed p-5"
    >
      <button
        type="button"
        aria-label="Close"
        class="border-parchment-300 text-parchment-700 inline-flex size-6 items-center justify-center rounded border"
        >×</button
      >
      <span class="text-parchment-500 text-sm">Easy to miss</span>
    </div>
  </div>
  <div
    class="border-parchment-200 space-y-3 border-t pt-5 sm:border-t-0 sm:border-l sm:pt-0 sm:pl-5"
  >
    <p class="text-parchment-500 font-mono text-xs">44px target</p>
    <div
      class="border-parchment-200 bg-parchment-50 flex items-center gap-3 rounded-lg border p-5"
    >
      <button
        type="button"
        aria-label="Close"
        class="border-parchment-300 text-parchment-900 inline-flex size-11 items-center justify-center rounded-lg border bg-white text-xl"
        >×</button
      >
      <span class="text-parchment-600 text-sm">Easy to hit</span>
    </div>
  </div>
</div>
