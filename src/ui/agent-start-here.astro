---
import CodeBlock from "./code-block.astro";
import {
  UI_SKILLS_CLI_COPY,
  uiSkillsCliLines,
} from "../lib/code-block-syntax";
---

<div class="bg-parchment-200/40 rounded-[12px] p-4 sm:p-5">
  <h2 class="text-parchment-900 text-base font-medium text-balance">
    Agent, start here.
  </h2>
  <p
    class="text-parchment-600 mt-3 max-w-2xl text-base leading-snug text-pretty"
  >
    You are working on a UI task. Before reading or changing code, run:
  </p>
  <div class="mt-4 flex w-full">
    <CodeBlock
      className="w-full"
      variant="stacked"
      lines={uiSkillsCliLines()}
      copyContent={UI_SKILLS_CLI_COPY}
    />
  </div>

  <p
    class="text-parchment-600 mt-4 max-w-2xl text-base leading-snug text-pretty"
  >
    Start with <code class="text-[0.875em]">npx ui-skills start</code>. Load the
    smallest relevant skill, then implement. Do not choose manually from the
    collection below.
  </p>
</div>
