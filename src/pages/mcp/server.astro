---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../ui/breadcrumbs.astro";
import CodeBlock from "../../ui/code-block.astro";
import { CopyButton } from "../../ui/copy-button";

const breadcrumbItems = [
  { label: "Home", href: "/" },
  { label: "MCP" },
];

const siteOrigin = Astro.site ?? new URL("https://www.ui-skills.com");
const mcpEndpoint = new URL("/mcp", siteOrigin).toString();
const serverCardUrl = new URL(
  "/.well-known/mcp/server-card.json",
  siteOrigin,
).toString();
const pageUrl = new URL("/mcp/server", siteOrigin).toString();

const tools = [
  {
    name: "list_skills",
    description:
      "List skills from the registry. Optional query filter over path, name, or description.",
  },
  {
    name: "get_skill",
    description:
      "Fetch skill markdown by discovery name, slug, or pathSlug.",
  },
];

const cliCommands = `npx ui-skills start
npx ui-skills categories
npx ui-skills list --category
npx ui-skills get`;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "MCP",
  description:
    "Connect agents to the UI Skills catalog over Model Context Protocol.",
  url: pageUrl,
};
---

<Layout
  structuredData={structuredData}
  title="MCP | UI Skills"
  description="Connect agents to the UI Skills catalog over Model Context Protocol."
>
  <div
    class="relative flex min-h-dvh flex-col items-center justify-start px-0 sm:px-4"
  >
    <div class="relative mt-20 w-full max-w-3xl sm:px-0">
      <div class="mx-auto flex w-full flex-col gap-10">
        <Breadcrumbs items={breadcrumbItems} />

        <div class="px-4 sm:px-0">
          <h1 class="text-parchment-900 text-3xl font-medium tracking-tight">
            MCP
          </h1>
          <p class="text-parchment-500 mt-3 max-w-2xl text-base leading-snug">
            Connect agents to the UI Skills catalog over Model Context Protocol.
            The server exposes the same registry as the
            <code class="text-[0.875em]">ui-skills</code> CLI.
          </p>
        </div>

        <section class="pb-6">
          <h2 class="text-parchment-900 mb-3 px-4 text-lg font-medium sm:px-0">
            Endpoint
          </h2>
          <CodeBlock
            lines={[[{ text: mcpEndpoint }]]}
            align="center"
            truncate
            copyContent={mcpEndpoint}
          />
          <p class="text-parchment-500 mt-3 px-4 text-base leading-snug sm:px-0">
            Server card:
            <a
              href={serverCardUrl}
              class="text-parchment-900 hover:text-parchment-600 ml-1 underline underline-offset-2"
            >
              {serverCardUrl}
            </a>
          </p>
        </section>

        <section class="px-4 pb-6 sm:px-0">
          <h2 class="text-parchment-900 text-lg font-medium tracking-tight">
            Tools
          </h2>
          <ul class="mt-3 space-y-4">
            {
              tools.map((tool) => (
                <li class="border-parchment-200 rounded-[12px] border bg-white px-6 py-5">
                  <div class="flex items-center justify-between gap-3">
                    <h3 class="text-parchment-900 font-mono text-base font-medium">
                      {tool.name}
                    </h3>
                    <CopyButton
                      content={tool.name}
                      showText={false}
                      className="size-8 shrink-0"
                      client:load
                    />
                  </div>
                  <p class="text-parchment-500 mt-2 text-base leading-snug">
                    {tool.description}
                  </p>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="px-4 pb-6 sm:px-0">
          <div class="bg-parchment-200/40 rounded-[12px] p-4 sm:p-5">
            <div class="flex w-full">
              <CodeBlock
                className="w-full"
                mobileSurface
                wrapOnMobile
                lines={[
                  [
                    { text: "npx", className: "text-[#953800]" },
                    { text: " ui-skills start", className: "text-[#0550ae]" },
                  ],
                  [
                    { text: "npx", className: "text-[#953800]" },
                    { text: " ui-skills categories", className: "text-[#0550ae]" },
                  ],
                  [
                    { text: "npx", className: "text-[#953800]" },
                    {
                      text: " ui-skills list --category",
                      className: "text-[#0550ae]",
                    },
                  ],
                  [
                    { text: "npx", className: "text-[#953800]" },
                    { text: " ui-skills get", className: "text-[#0550ae]" },
                  ],
                ]}
                copyContent={cliCommands}
              />
            </div>
          </div>
        </section>
      </div>
    </div>
  </div>
</Layout>
