---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../ui/breadcrumbs.astro";
import PlaybookCard from "../../ui/playbook-card.astro";
import { playbook } from "../../data/playbook.ts";
import { skills } from "../../data/skills.ts";

const breadcrumbItems = [{ label: "Home", href: "/" }, { label: "Playbook" }];

const playbookCards = playbook
  .map((entry) => {
    const sourceSkill = skills.find((skill) => skill.slug === entry.skillSlug);

    return sourceSkill ? entry : null;
  })
  .filter((entry): entry is NonNullable<typeof entry> => Boolean(entry));

const siteOrigin = Astro.site ?? new URL("https://www.ui-skills.com");
const pageUrl = new URL("/playbook", siteOrigin).toString();
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Playbook",
  description: "Distilled UI lessons from the registry.",
  url: pageUrl,
  hasPart: {
    "@type": "ItemList",
    itemListElement: playbook.map((entry, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: new URL(`/playbook/${entry.slug}`, siteOrigin).toString(),
      name: entry.title,
    })),
  },
};
---

<Layout
  structuredData={structuredData}
  title="Playbook | UI Skills"
  description="Distilled UI lessons from the registry."
>
  <div class="relative flex min-h-dvh flex-col items-center px-0 sm:px-4">
    <div class="relative mt-20 w-full max-w-3xl sm:px-0">
      <div class="mx-auto flex w-full flex-col gap-8">
        <Breadcrumbs items={breadcrumbItems} />

        <div class="px-4 sm:px-0">
          <h1 class="text-parchment-900 text-3xl font-medium tracking-tight text-balance">
            Playbook
          </h1>
          <p class="text-parchment-600 mt-3 max-w-2xl text-base text-pretty leading-snug">
            Distilled UI lessons from the registry. Each card is one rule the
            agent should apply.
          </p>
        </div>

        <div class="grid gap-4 px-4 sm:grid-cols-2 sm:px-0">
          {playbookCards.map((entry) => (
            <PlaybookCard
              href={`/playbook/${entry.slug}`}
              title={entry.title}
              description={entry.description}
            />
          ))}
        </div>
      </div>
    </div>
  </div>
</Layout>
