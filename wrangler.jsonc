{
  "name": "ui-skills",
  "compatibility_date": "2026-01-07",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/mcp",
      "/oauth/*",
      "/_server-islands/*",
      "/_image",
    ],
  },
}
